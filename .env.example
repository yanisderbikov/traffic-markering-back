# ============================================================================
#  Переменные окружения traffic-markering-back.
#  Скопируй в .env (он в .gitignore) и поправь под себя.
#  Значения ниже рассчитаны на локальный запуск с базой из docker-compose.yml.
# ============================================================================

# Откуда фронту разрешено ходить в API (CORS). Список через запятую.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Публичный адрес самого бэкенда — подставляется в Swagger как server url
# и из него собирается redirect URI для OAuth соцсетей.
# На проде: URL_BACK=https://social-traffic-back.up.railway.app
URL_BACK=http://localhost:8090

# Подключение к PostgreSQL (совпадает с сервисом postgres из docker-compose.yml)
POSTGRES_URL=jdbc:postgresql://localhost:5432/traffic_markering
POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic

# Секрет подписи JWT. В проде — длинная случайная строка, минимум 32 байта:
# openssl rand -base64 48
JWT_SECRET=local-dev-jwt-secret-change-me-please-32-bytes-min

# Срок жизни токена в секундах (по умолчанию неделя)
JWT_EXPIRATION_SECONDS=604800

# Общий секрет внешнего анализатора просмотров: с ним ходят в /api/tech/**
# и /api/actuator/**. Пусто = технические ручки закрыты для всех.
SERVICE_JWT_TOKEN=

# Фоновая синхронизация просмотров: включена, раз в 5 минут, первый запуск через 30 с.
# Провайдер просмотров сейчас заглушка, так что реального трафика она не создаёт.
VIEWS_SYNC_ENABLED=true
VIEWS_SYNC_FIXED_RATE_MS=300000
VIEWS_SYNC_INITIAL_DELAY_MS=30000

# Яндекс Object Storage: фото объявлений грузятся туда напрямую по presigned-ссылкам.
# Ключи создаются в консоли Яндекс Облака (сервисный аккаунт с ролью storage.editor).
S3_KEY=
S3_SECRET=
S3_BUCKET=
# Эндпоинт и регион по умолчанию — Яндекс (storage.yandexcloud.net / ru-central1).
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1

# Куда бэк возвращает браузер после согласия площадки (адрес фронта).
# На проде: FRONT_URL=https://social-traffic.up.railway.app
FRONT_URL=http://localhost:3000

# Ключ шифрования токенов соцсетей в базе. Пусто — берётся JWT_SECRET.
# Меняешь ключ — все привязанные аккаунты придётся подключать заново.
SOCIAL_TOKEN_SECRET=

# OAuth-приложения площадок. Пустые ключи = площадка выключена (ручка отдаёт 503).
# Redirect URI, который надо прописать в каждом приложении (совпадение посимвольное):
#   https://social-traffic-back.up.railway.app/api/social/callback/youtube
#   https://social-traffic-back.up.railway.app/api/social/callback/tiktok
#   https://social-traffic-back.up.railway.app/api/social/callback/instagram
#
# Ссылки на документы для форм регистрации приложений:
#   Terms of Service: https://social-traffic.up.railway.app/info/terms
#   Privacy Policy:   https://social-traffic.up.railway.app/info/privacy

# Google Cloud Console → APIs & Services → Credentials, включить YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# developers.tiktok.com → Manage apps → Login Kit, права user.info.* и video.list
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# developers.facebook.com → приложение с продуктом «Instagram API with Instagram Login»,
# права instagram_business_basic и instagram_business_manage_insights
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
